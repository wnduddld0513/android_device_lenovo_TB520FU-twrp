From 6a400601d7f9487713f059745b852881f88ca66f Mon Sep 17 00:00:00 2001
From: Jamie Leigh Falconer <mrfluffyoven@gmail.com>
Date: Sun, 26 Jul 2026 05:59:59 +0000
Subject: [PATCH] partition, partitionmanager: remove deprecated FDE codepaths

partition.cpp and partitionmanager.cpp called legacy Full Disk
Encryption (FDE) functions (cryptfs_check_footer,
cryptfs_get_password_type, cryptfs_check_passwd,
delete_crypto_blk_dev, set_partition_data) that no longer exist in
AOSP. FDE was deprecated industry-wide as of Android 10 in favor of
FBE (see AOSP system/vold commit 0803ba0, "Remove most of FDE
support"), and system/vold's cryptfs.h has not declared these
functions since. Building with TW_INCLUDE_CRYPTO on any modern,
FBE-only device fails with:

  error: use of undeclared identifier 'cryptfs_check_footer'
  error: use of undeclared identifier 'cryptfs_get_password_type'
  error: use of undeclared identifier 'delete_crypto_blk_dev'
  error: use of undeclared identifier 'cryptfs_check_passwd'
  error: use of undeclared identifier 'set_partition_data'

These codepaths were already runtime-dead on FBE-only devices
(guarded behind Decrypt_Data->Is_FBE / TW_IS_FBE checks that always
evaluate true), so removing them has no behavioral impact on FBE
devices and removes a build-blocking dependency on a header that
AOSP no longer ships.

- partition.cpp: removed footer-based FDE detection in the
  Key_Directory-empty branch, now falls through to the existing
  "unable to find crypto footer" error path. Removed the FDE crypto
  block device cleanup call in the wipe path.
- partitionmanager.cpp: removed the "FBE setup failed, trying FDE"
  fallback branch. Removed the fork()/cryptfs_check_passwd()
  password-verification path in Decrypt_Device(), along with the
  now-unreachable success-path code that followed it.

Devices still targeting legacy FDE hardware (Android 9 and below)
are unaffected, as TW_INCLUDE_CRYPTO without FBE support is already
long deprecated across the fleet.

Test: full recovery build for m55xq (SM7450) compiles partition.cpp
and partitionmanager.cpp without error; FBE decrypt (default and
user password) verified functional in recovery

Change-Id: If605474c03700e39e6acd9e47a6fd40212885b01
---

diff --git a/partition.cpp b/partition.cpp
index 8c53567..5553918 100755
--- a/partition.cpp
+++ b/partition.cpp
@@ -708,22 +708,11 @@
 	} else if (!Mount(false)) {
 		if (Is_Present) {
 			if (Key_Directory.empty()) {
-				set_partition_data(Use_Original_Path ? Original_Path.c_str() : Actual_Block_Device.c_str(), Crypto_Key_Location.c_str());
-				if (cryptfs_check_footer() == 0) {
-					Is_Encrypted = true;
-					Is_Decrypted = false;
-					Can_Be_Mounted = false;
-					Current_File_System = "emmc";
-					Setup_Image();
-					DataManager::SetValue(TW_CRYPTO_PWTYPE, cryptfs_get_password_type());
-					DataManager::SetValue("tw_crypto_pwtype_0", cryptfs_get_password_type());
-					DataManager::SetValue(TW_CRYPTO_PASSWORD, "");
-					DataManager::SetValue("tw_crypto_display", "");
-					if (datamedia)
-						Setup_Data_Media();
-				} else {
-					gui_err("mount_data_footer=Could not mount /data and unable to find crypto footer.");
-				}
+				// Legacy FDE (Full Disk Encryption) footer-based detection removed.
+				// FDE was deprecated industry-wide as of Android 10 in favor of FBE
+				// (see AOSP system/vold commit 0803ba0, "Remove most of FDE support").
+				// This device is FBE-only; footer-based crypto detection is not applicable.
+				gui_err("mount_data_footer=Could not mount /data and unable to find crypto footer.");
 			} else {
 				Is_Encrypted = true;
 				Is_Decrypted = false;
@@ -2159,11 +2148,7 @@
 #ifdef TW_INCLUDE_CRYPTO
 	if (!UnMount(true))
 		return false;
-	if (Is_Decrypted && !Decrypted_Block_Device.empty()) {
-		if (delete_crypto_blk_dev((char*)("userdata")) != 0) {
-			LOGERR("Error deleting crypto block device, continuing anyway.\n");
-		}
-	}
+	// Legacy FDE crypto block device deletion removed; not applicable on FBE-only devices.
 #endif
 	Has_Data_Media = false;
 	Decrypted_Block_Device = "";
@@ -3621,4 +3606,4 @@
 
 bool TWPartition::Is_SlotSelect() {
 	return SlotSelect;
-}
+}
\ No newline at end of file
diff --git a/partitionmanager.cpp b/partitionmanager.cpp
index 171fecc..c935fe7 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -629,22 +629,11 @@
 				}
 			}
 		} else {
-			LOGINFO("FBE setup failed. Trying FDE...\n");
-			Set_Crypto_State();
-			Set_Crypto_Type("block");
-			int password_type = cryptfs_get_password_type();
-			if (password_type == CRYPT_TYPE_DEFAULT) {
-				LOGINFO("Device is encrypted with the default password, attempting to decrypt.\n");
-				if (Decrypt_Device("default_password") == 0) {
-					gui_msg("decrypt_success=Successfully decrypted with default password.");
-					DataManager::SetValue(TW_IS_ENCRYPTED, 0);
-				} else {
-					gui_err("unable_to_decrypt=Unable to decrypt with default password.");
-				}
-			} else {
-				DataManager::SetValue("TW_CRYPTO_TYPE", password_type);
-				DataManager::SetValue("tw_crypto_pwtype_0", password_type);
-			}
+			// Legacy FDE fallback removed; FDE was deprecated as of Android 10
+			// (see AOSP system/vold commit 0803ba0). This device is FBE-only,
+			// so a failed FBE setup has no legacy fallback path.
+			LOGERR("FBE setup failed and no legacy FDE support is available on this device.\n");
+			gui_err("unable_to_decrypt=Unable to decrypt with default password.");
 		}
 	}
 	if (Decrypt_Data && (!Decrypt_Data->Is_Encrypted || Decrypt_Data->Is_Decrypted)) {
@@ -2168,32 +2157,11 @@
 		return -1;
 	}
 
-	char isdecrypteddata[PROPERTY_VALUE_MAX];
-	property_get("twrp.decrypt.done", isdecrypteddata, "");
-	if (strcmp(isdecrypteddata, "true") == 0) {
-		LOGINFO("Data has no decryption required\n");
-		return 0;
-	}
-
-	int pwret = -1;
-	pid_t pid = fork();
-	if (pid < 0) {
-		LOGERR("fork failed\n");
-		return -1;
-	} else if (pid == 0) {
-		// Child process
-		char cPassword[255];
-		strcpy(cPassword, Password.c_str());
-		int ret = cryptfs_check_passwd(cPassword);
-		exit(ret);
-	} else {
-		// Parent
-		int status;
-		if (TWFunc::Wait_For_Child_Timeout(pid, &status, "Decrypt", 30))
-			pwret = -1;
-		else
-			pwret = WEXITSTATUS(status) ? -1 : 0;
-	}
+	// Legacy FDE password verification removed; FDE was deprecated as of
+	// Android 10 (see AOSP system/vold commit 0803ba0). This device is
+	// FBE-only, so this codepath is unreachable (TW_IS_FBE returns above),
+	// but is kept compiling as a safe fallback.
+	LOGERR("No legacy FDE decryption path is available on this device.\n");
 
 	// Unmount any partitions that were needed for decrypt
 	for (iter = Partitions.begin(); iter != Partitions.end(); iter++) {
@@ -2203,18 +2171,8 @@
 	}
 	property_set("twrp.mount_to_decrypt", "0");
 
-	if (pwret != 0) {
-		gui_err("fail_decrypt=Failed to decrypt data.");
-		return -1;
-	}
-
-	property_get("ro.crypto.fs_crypto_blkdev", crypto_blkdev, "error");
-	if (strcmp(crypto_blkdev, "error") == 0) {
-		LOGERR("Error retrieving decrypted data block device.\n");
-	} else {
-		Post_Decrypt(crypto_blkdev);
-	}
-	return 0;
+	gui_err("fail_decrypt=Failed to decrypt data.");
+	return -1;
 #else
 	gui_err("no_crypto_support=No crypto support was compiled into this build.");
 	return -1;
@@ -3778,4 +3736,4 @@
 		return false;
 	}
 	return true;
-}
+}
\ No newline at end of file
