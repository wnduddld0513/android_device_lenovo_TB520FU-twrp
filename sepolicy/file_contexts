# init (enforcing even in recovery) writes the bootloader message to misc
# before "reboot,recovery"/fastboot/sideload. Without a label misc is plain
# block_device, the write is denied and init cancels the reboot, so
# Reboot -> Recovery only restarted TWRP.
/dev/block/by-name/misc                                  u:object_r:misc_block_device:s0
/dev/block/bootdevice/by-name/misc                       u:object_r:misc_block_device:s0
/dev/block/platform/soc/1d84000\.ufshc/by-name/misc      u:object_r:misc_block_device:s0
